{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Run",
  "description": "The document emitted by `atlas run --json` and by AtlasRunState.to_dict().",
  "type": "object",
  "required": [
    "schema",
    "task",
    "run_id",
    "created_at",
    "status",
    "iteration",
    "max_iterations",
    "route",
    "plan",
    "observations",
    "outputs",
    "evaluations"
  ],
  "properties": {
    "schema": {
      "const": "atlas-run.v1"
    },
    "task": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "observing",
        "routing",
        "planning",
        "executing",
        "evaluating",
        "replanning",
        "need_user_approval",
        "done",
        "failed"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "route": {
      "type": ["object", "null"],
      "description": "Null only when the loop never ran an iteration.",
      "properties": {
        "name": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "risk_level": { "type": "string" }
      }
    },
    "plan": {
      "type": ["object", "null"],
      "properties": {
        "goal": { "type": "string" },
        "route_name": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" } },
        "validation_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluations": {
      "type": "array",
      "description": "Each item conforms to atlas-evaluation.v1.",
      "items": { "type": "object" }
    },
    "memory_candidates": {
      "type": "array",
      "description": "Each item conforms to atlas-memory-candidate.v1.",
      "items": { "type": "object" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "safety_notice": { "type": "string" }
      }
    }
  }
}
