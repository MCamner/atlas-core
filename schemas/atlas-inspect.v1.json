{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-inspect.v1.json",
  "title": "Atlas Run Inspection",
  "description": "A read-only projection of one validated atlas-event.v1 history. Derived fields summarize the selected events; events remains the audit source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "route",
    "iterations",
    "stop_reason",
    "stop_class",
    "sources",
    "uncertainties",
    "unfinished_calls",
    "calls",
    "event_count",
    "started_at",
    "finished_at",
    "events"
  ],
  "properties": {
    "schema": { "const": "atlas-inspect.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "route": { "type": ["string", "null"] },
    "iterations": { "type": "integer", "minimum": 0 },
    "stop_reason": { "type": ["string", "null"] },
    "stop_class": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_details": {
      "description": "Optional. Where each source is and the digest of the bytes the run last graded, from observation_recorded. A supersession replaces the digest; events keeps every reading. `unknown` where an older log did not record a field.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "content_sha256"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content_sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "unfinished_calls": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "ok", "denied", "failed", "unknown"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ok": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "event_count": { "type": "integer", "minimum": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "atlas-event.v1.json" }
    }
  }
}
